NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://admin:admin_password@localhost:5432/notification_db?schema=public"
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_REQUEST_QUEUE=notification.transaction.requested
RABBITMQ_CONFIRMATION_QUEUE=notification.transaction.confirmed
RABBITMQ_PREFETCH_COUNT=10
NOTIFICATION_CHANNEL=LOG
